{
  "compilerOptions": {
    "lib": ["DOM", "ES2022"],
    "target": "es2018",
    "module": "ESNext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.old.ts", "src/**/*.dev.ts"]
}
